<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Theme (Modern-Fit Primary Theme). -->
    <style name="Base.Theme.GymTras" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_neon_lime</item>
        <item name="colorOnPrimary">@color/on_primary_dark</item>
        <item name="colorSecondary">@color/secondary_electric_cyan</item>
        <item name="colorOnSecondary">@color/bg_dark_charcoal</item>
        <item name="colorError">@color/color_error</item>

        <!-- Status Bar & Window Background -->
        <item name="android:statusBarColor">@color/bg_dark_charcoal</item>
        <item name="android:navigationBarColor">@color/bg_dark_charcoal</item>
        <item name="android:windowBackground">@color/bg_dark_charcoal</item>

        <!-- Component Overrides -->
        <item name="textInputStyle">@style/Widget.GymTras.TextInputLayout</item>
        <item name="radioButtonStyle">@style/Widget.GymTras.RadioButton</item>
    </style>

    <style name="Theme.GymTras" parent="Base.Theme.GymTras" />
</resources>
