<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_dark_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/surface_input_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvExerciseNumber"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_lime"
            android:gravity="center"
            android:textColor="@color/primary_neon_lime"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvExerciseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Press de Banca Plano"
            app:layout_constraintEnd_toStartOf="@id/btnDeleteExercise"
            app:layout_constraintStart_toEndOf="@id/tvExerciseNumber"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnDeleteExercise"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Metrics Chips -->
        <LinearLayout
            android:id="@+id/metricsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvExerciseNumber"
            app:layout_constraintTop_toBottomOf="@id/tvExerciseName">

            <!-- Weight Chip -->
            <TextView
                android:id="@+id/tvWeightChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_lime"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/primary_neon_lime"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="🏋️ 80 kg" />

            <!-- Sets/Reps Chip -->
            <TextView
                android:id="@+id/tvSetsRepsChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_dark"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_primary_dark"
                android:textSize="12sp"
                tools:text="4 series x 10 reps" />

            <!-- Rest Chip -->
            <TextView
                android:id="@+id/tvRestChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_cyan"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/secondary_electric_cyan"
                android:textSize="12sp"
                tools:text="⏱ 90s" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
